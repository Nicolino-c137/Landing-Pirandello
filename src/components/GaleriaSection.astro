---
const base = import.meta.env.BASE_URL;

const fotos = [
  { src: `${base}assets/images/galeria1.jpg`, alt: 'Ambiente del restaurante Pirandello Lomos' },
  { src: `${base}assets/images/galeria2.jpg`, alt: 'Platos y preparaciones de Pirandello Lomos' },
  { src: `${base}assets/images/galeria3.jpg`, alt: 'Parrilla y carnes de Pirandello Lomos' },
  { src: `${base}assets/images/galeria4.jpg`, alt: 'Interior del local Pirandello Lomos' },
  { src: `${base}assets/images/galeria5.jpg`, alt: 'Especialidades de la casa en Pirandello Lomos' },
  { src: `${base}assets/images/galeria6.jpg`, alt: 'Experiencia gastronómica en Pirandello Lomos' },
];
---

<section id="galeria" class="py-24" style="background-color: var(--color-surface)">
  <div class="section-container">

    <div class="text-center mb-16 fade-in">
      <p class="text-xs uppercase tracking-[0.3em] mb-4" style="color: var(--color-primary)">Momentos Pirandello</p>
      <h2 class="heading-xl" style="margin-bottom: 1.5rem; color: var(--color-on-surface)">Galería</h2>
      <div class="flex justify-center mt-6">
        <div class="w-25 h-px mx-auto mt-6" style="margin-bottom:3.5rem; background-color: var(--color-primary)"></div>
      </div>
    </div>

    <div class="galeria-grid">
      {fotos.map((foto) => (
        <div class="galeria-item group fade-in">
          <img
            src={foto.src}
            alt={foto.alt}
            loading="lazy"
            width="800"
            height="600"
            class="galeria-img"
          />
        </div>
      ))}
    </div>

  </div>
</section>

<style>
  .galeria-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 15px;
  }

  @media (min-width: 768px) {
    .galeria-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .galeria-item {
    overflow: hidden;
    aspect-ratio: 4 / 3;
  }

  .galeria-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.8s cubic-bezier(0.25, 0.46, 0.45, 0.94),
                filter 0.5s ease;
    filter: brightness(0.85) saturate(0.9);
  }

  .galeria-item:hover .galeria-img {
    transform: scale(1.06);
    filter: brightness(1) saturate(1.05);
  }
</style>
