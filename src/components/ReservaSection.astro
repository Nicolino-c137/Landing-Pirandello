---
const WA_NUMBER = '542645060974';
const WA_BASE = `https://wa.me/${WA_NUMBER}`;
---

<section id="reservas" class="py-24" style="background-color: var(--color-surface-low)">
  <div class="section-container">

    <div class="grid md:grid-cols-2 gap-12 lg:gap-20 items-center">

      <div class="fade-in">
        <p class="text-xs uppercase tracking-[0.3em] mb-4" style="color: var(--color-primary)">Reservá tu lugar</p>
        <h2 class="heading-xl mb-6" style="margin-bottom: 1.5rem; color: var(--color-on-surface)">Hacé tu reserva</h2>
        <p class="body-lg mb-10" style="margin-bottom: 1.5rem; color: var(--color-on-surface-muted)">
          Reservá tu mesa y asegurate un lugar en nuestra sala. Te confirmamos por WhatsApp a la brevedad.
        </p>

        <div class="space-y-6">
          <div class="info-row">
            <span class="info-icon" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"/>
                <polyline points="12 6 12 12 16 14"/>
              </svg>
            </span>
            <div style="margin-bottom:1.5rem;">
              <p class="info-label">Horarios</p>
              <p class="info-value">Lunes a Domingo · 20:00 a 01:00</p>
            </div>
          </div>

          <div class="info-row">
            <span class="info-icon" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
                <circle cx="12" cy="10" r="3"/>
              </svg>
            </span>
            <div style="margin-bottom:1.5rem;">
              <p class="info-label">Dirección</p>
              <p class="info-value">Av. Lib. San Martín O 3105<br />J5400 Rivadavia, San Juan</p>
            </div>
          </div>

          <div class="info-row">
            <span class="info-icon" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.62 3.33 2 2 0 0 1 3.6 1.3h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L7.91 8.56a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
              </svg>
            </span>
            <div>
              <p class="info-label">Delivery</p>
              <p class="info-value">4262725 · 4260260</p>
            </div>
          </div>
        </div>
      </div>

      <div class="fade-in">
        <form id="reserva-form" class="reserva-form">

          <div class="form-row grid grid-cols-1 sm:grid-cols-2 gap-px">
            <div class="form-field">
              <label for="nombre" class="form-label">Nombre</label>
              <input type="text" id="nombre" name="nombre" placeholder="Tu nombre" required class="form-input" autocomplete="given-name" />
            </div>
            <div class="form-field">
              <label for="apellido" class="form-label">Apellido</label>
              <input type="text" id="apellido" name="apellido" placeholder="Tu apellido" required class="form-input" autocomplete="family-name" />
            </div>
          </div>

          <div class="form-row grid grid-cols-1 sm:grid-cols-2 gap-px">
            <div class="form-field">
              <label for="fecha" class="form-label">Fecha</label>
              <input type="date" id="fecha" name="fecha" required class="form-input" />
            </div>
            <div class="form-field">
              <label for="personas" class="form-label">Personas</label>
              <select id="personas" name="personas" required class="form-input form-select">
                <option value="" disabled selected>Cantidad</option>
                {[1,2,3,4,5,6,7,8].map(n => (
                  <option value={n}>{n} persona{n > 1 ? 's' : ''}</option>
                ))}
                <option value="mas">Más de 8</option>
              </select>
            </div>
          </div>

          <div class="form-field">
            <label for="mensaje" class="form-label">Mensaje (opcional)</label>
            <textarea id="mensaje" name="mensaje" placeholder="¿Alguna preferencia o aclaración?" rows={3} class="form-input"></textarea>
          </div>

          <button type="submit" id="submit-btn" class="btn-submit">
            Enviar reserva por WhatsApp
          </button>

          <p id="form-status" class="form-status" aria-live="polite"></p>

        </form>
      </div>

    </div>
  </div>
</section>

<script define:vars={{ WA_BASE }}>
  const form = document.getElementById('reserva-form');
  const btn = document.getElementById('submit-btn');
  const status = document.getElementById('form-status');

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const data = new FormData(form);
    const nombre   = data.get('nombre')?.toString().trim() ?? '';
    const apellido = data.get('apellido')?.toString().trim() ?? '';
    const fechaRaw    = data.get('fecha')?.toString() ?? '';
    let fecha = '';
    if (fechaRaw) {
      const [year, month, day] =fechaRaw.split('-');
      fecha = `${day}/${month}`;
    }
    const personas = data.get('personas')?.toString() ?? '';
    const mensaje  = data.get('mensaje')?.toString().trim() ?? '';

    const texto = [
      `Hola! Quiero hacer una reserva a nombre de ${nombre} ${apellido} para el día ${fecha}, somos ${personas} personas`,
      mensaje ? `${mensaje}` : '',
    ].filter(Boolean).join('\n');

    window.open(`${WA_BASE}?text=${encodeURIComponent(texto)}`, '_blank', 'noopener,noreferrer');
    if (status) status.textContent = 'Abriendo WhatsApp...';
    form.reset();
  });
</script>

<style>
  .reserva-form {
    background-color: var(--color-surface-high);
    border: 1px solid var(--color-border);
  }

  .form-field {
    background-color: var(--color-surface-card);
    padding: 1.25rem 1.5rem;
  }

  .form-label {
    display: block;
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--color-primary);
    margin-bottom: 0.5rem;
    font-weight: 500;
  }

  .form-input {
    width: 100%;
    background: transparent;
    border: none;
    border-bottom: 1px solid var(--color-border);
    color: var(--color-on-surface);
    font-family: 'Inter', sans-serif;
    font-size: 0.9rem;
    padding: 0.375rem 0;
    outline: none;
    transition: border-color 0.2s ease;
    appearance: none;
  }

  .form-input::placeholder { color: var(--color-on-surface-muted); opacity: 0.6; }
  .form-input:focus { border-bottom-color: var(--color-primary); }

  .form-select { cursor: pointer; }
  .form-select option {
    background-color: var(--color-surface-high);
    color: var(--color-on-surface);
  }

  input[type="date"]::-webkit-calendar-picker-indicator {
    filter: invert(0.7) sepia(1) saturate(3) hue-rotate(5deg);
    cursor: pointer;
  }

  .btn-submit {
    display: block;
    width: 100%;
    background-color: var(--color-primary);
    color: var(--color-surface);
    font-family: 'Inter', sans-serif;
    font-weight: 500;
    font-size: 0.8rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    padding: 1.1rem 2rem;
    border: none;
    cursor: pointer;
    transition: background-color 0.25s ease;
    margin-top: 1px;
  }
  .btn-submit:hover { background-color: var(--color-primary-dark); }

  .form-status {
    font-size: 0.75rem;
    text-align: center;
    padding-top: 0.75rem;
    color: var(--color-on-surface-muted);
    min-height: 1.5rem;
  }

  .info-row { display: flex; align-items: flex-start; gap: 1rem; }
  .info-icon { flex-shrink: 0; color: var(--color-primary); margin-top: 0.1rem; }
  .info-label {
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--color-primary);
    margin-bottom: 0.3rem;
    font-weight: 500;
  }
  .info-value { font-size: 0.875rem; color: var(--color-on-surface-muted); line-height: 1.6; }
</style>
