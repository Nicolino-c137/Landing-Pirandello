---
const base = import.meta.env.BASE_URL.replace(/\/?$/, '');

const navLinks = [
  { href: '#menu', label: 'Menú' },
  { href: '#galeria', label: 'Galería' },
  { href: '#reservas', label: 'Reservas' },
];
---

<header id="main-nav" class="fixed top-0 left-0 right-0 z-50 transition-all duration-300">
  <nav class="flex items-center justify-between px-4 sm:px-8 py-4 w-full max-w-screen-xl mx-auto">

    <a href={`${base}/`} aria-label="Pirandello Lomos — Inicio" class="flex-shrink-0">
      <img src={`${base}/logo.svg`} alt="Pirandello Lomos" class="logo-img w-auto" />
    </a>

    <ul class="hidden md:flex gap-6 lg:gap-10">
      {navLinks.map(link => (
        <li>
          <a href={link.href} class="nav-link text-xs uppercase tracking-widest font-medium transition-opacity duration-200 hover:opacity-60">
            {link.label}
          </a>
        </li>
      ))}
    </ul>

    <button
      id="mobile-menu-btn"
      class="md:hidden flex flex-col gap-1.5 p-2"
      style="margin-right: 1rem;"
      aria-label="Abrir menú"
      aria-expanded="false"
    >
      <span class="block w-6 h-px bg-current transition-all duration-300"></span>
      <span class="block w-6 h-px bg-current transition-all duration-300"></span>
      <span class="block w-6 h-px bg-current transition-all duration-300"></span>
    </button>
  </nav>

  <div id="mobile-menu" class="md:hidden hidden border-t px-6 py-8 mobile-panel">
    <ul class="flex flex-col gap-6 items-center text-center" style="margin-bottom: 1rem;">
      {navLinks.map(link => (
        <li>
          <a href={link.href} class="mobile-nav-link text-sm uppercase tracking-widest font-medium block">
            {link.label}
          </a>
        </li>
      ))}
    </ul>
  </div>
</header>

<script>
  const nav = document.getElementById('main-nav');
  const mobileBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');

  window.addEventListener('scroll', () => {
    if (window.scrollY > 80) {
      nav?.classList.add('scrolled');
    } else {
      nav?.classList.remove('scrolled');
    }
  }, { passive: true });

  mobileBtn?.addEventListener('click', () => {
    const isOpen = !mobileMenu?.classList.contains('hidden');
    mobileMenu?.classList.toggle('hidden');
    mobileBtn.setAttribute('aria-expanded', String(!isOpen));
  });

  document.querySelectorAll('.mobile-nav-link').forEach(link => {
    link.addEventListener('click', () => {
      mobileMenu?.classList.add('hidden');
      mobileBtn?.setAttribute('aria-expanded', 'false');
    });
  });
</script>

<style>
  #main-nav {
    background: transparent;
    color: var(--color-on-surface);
  }

  #main-nav.scrolled {
    background: color-mix(in srgb, var(--color-surface) 90%, transparent);
    backdrop-filter: blur(var(--nav-blur));
  }
  
  .mobile-panel {
    background-color: var(--color-surface-low);
    border-color: var(--color-border);
  }
</style>